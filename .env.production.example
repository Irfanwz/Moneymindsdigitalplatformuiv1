JWT_SECRET=CHANGE_ME_to_a_random_string_at_least_32_chars
ADMIN_EMAIL=admin@moneymindsdigital.site
ADMIN_PASSWORD=CHANGE_ME_strong_password
ADMIN_NAME=Platform Admin
# Set false to pause authenticator login and setup; saved factors are preserved.
TWO_FACTOR_ENABLED=true
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# One-time opt-in for automatic Docker startup migrations. Copy the Direct or
# Session pooler URI (port 5432) from Supabase > Connect, with the DB password.
# Keep false to continue applying SQL manually.
AUTO_MIGRATE=false
SUPABASE_DB_URL=
# Optional override: PEM root CA from Supabase Database settings, with literal \n
# separators. The official Supabase production CA is bundled by default.
# Certificate and hostname verification are always enabled.
SUPABASE_DB_SSL_CA=

NODE_ENV=production
API_PORT=3001
CLIENT_ORIGIN=https://moneymindsdigital.site
VITE_API_BASE_URL=
AI_PROVIDER=auto
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
TAVILY_API_KEY=
ALPHA_VANTAGE_KEY=
FINNHUB_API_KEY=
AGENT_TIMEZONE=Asia/Karachi
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SENDGRID_API_KEY=
